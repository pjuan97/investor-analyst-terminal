# =============================================================================
# DATABASE
# =============================================================================

# Local Docker Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/investor_terminal?schema=public"

# Or use Supabase (uncomment and fill in)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Secret for JWT signing (generate with: openssl rand -base64 32)
AUTH_SECRET="your-secret-key-change-this-in-production"

# Session duration in days
SESSION_DURATION_DAYS=7

# =============================================================================
# SEC EDGAR (Required - FREE)
# =============================================================================

# User agent for SEC API requests (required by SEC)
# Format: "AppName/Version (contact@email.com)"
SEC_USER_AGENT="InvestorAnalystTerminal/1.0 (your-email@example.com)"

# =============================================================================
# PRICE PROVIDER
# =============================================================================

# Options: "stooq" (free), "fmp" (requires key), "alpha_vantage" (requires key)
PRICE_PROVIDER="stooq"

# =============================================================================
# FMP (Optional - Paid, but has free tier)
# =============================================================================

# Get your API key from: https://site.financialmodelingprep.com/developer
# FMP_API_KEY="your-fmp-api-key"

# =============================================================================
# ALPHA VANTAGE (Optional - Free tier available)
# =============================================================================

# Get your API key from: https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY="your-alpha-vantage-key"

# =============================================================================
# CRON / JOBS
# =============================================================================

# Secret for protected API routes (generate with: openssl rand -base64 32)
CRON_SECRET="your-cron-secret-change-this"

# Enable daily cron job (set to "true" to enable)
ENABLE_CRON="true"

# =============================================================================
# ENVIRONMENT
# =============================================================================

NODE_ENV="development"
